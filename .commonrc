# -*- mode: sh; sh-shell: bash; -*-
# common/shared shell config code
#

sourceIfExists () {
    if [ -f "$1" ]; then
        source "$1"
    fi
}

# sourceIfExists "$HOME/.config/workstation/settings.current.sh"

export WS_CONFIG="${WS_CONFIG:-$HOME/.config/funstation}"

sourceIfExists ${WS_CONFIG}/lib/shell/settings.sh
sourceIfExists ${WS_CONFIG}/lib/shell/paths.sh
# sourceIfExists ${WS_DIR}/hosts/current/zshrc.sh

export EDITOR=emacsclient
export GIT_EDITOR=$EDITOR

export LANG=en_US.UTF-8

# TODO figure out how to make this work in zsh
# shopt -s extglob

export HISTCONTROL=erasedups
export HISTSIZE=10000
export HISTCONTROL=ignoreboth
export HISTFILESIZE=2000

export GOPATH="$HOME/.local/share/go"

do_command_done_alert() {
    osascript -e 'display dialog "Command Done!"'
}

alert_when_done() {
    if test -n "$1";
    then
        while kill -0 $1
        do
            sleep 1
        done
    fi
    do_command_done_alert
}

sourceIfExists /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh
sourceIfExists ~/.nix-profile/etc/profile.d/hm-session-vars.sh
# sourceIfExists ~/workstation/lib/shell/funcs.sh
sourceIfExists ~/.ghcup/env

# home-manager's shell integration.
#
# home-manager writes the hooks its programs.* modules want (direnv today;
# zoxide, fzf, atuin, starship if ever added) into programs.{bash,zsh}.init*,
# but only installs them by managing ~/.bashrc -- which it must not do here,
# since these rc files are hand-maintained in the dotfiles repo.  So the nix
# config harvests that text into the files sourced below.  See Note
# [Harvesting home-manager's shell integration] in
# .config/funstation/nix/flake.nix.
#
# This replaces a hand-copied `direnv hook` that used to live here.  Anything
# home-manager adds later now arrives on its own.
#
# Kept last so these run after the rest of the shell is set up; the files
# themselves reference absolute /nix/store paths and so do not need PATH.
if [ -n "${BASH_VERSION:-}" ]; then
    sourceIfExists ~/.shell-rc-home-manager.bash
elif [ -n "${ZSH_VERSION:-}" ]; then
    sourceIfExists ~/.shell-rc-home-manager.zsh
fi

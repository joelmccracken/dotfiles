Host github.com
    HostName github.com
    User git
    IdentityFile ~/secrets/id_ed25519_personal
    IdentitiesOnly yes

Host github-xdev
    HostName github.com
    User git
    IdentityFile ~/.ssh/id_ed25519_protected
    IdentitiesOnly yes

# Default key. IdentityFile entries accumulate, so list any host with its own
# key after the `*` as `!alias`; otherwise this key gets offered as a fallback there too.
Host * !github-xdev
    IdentityFile ~/secrets/id_ed25519_personal
